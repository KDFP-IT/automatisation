FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATABASE_PATH=/data/trench.sqlite3
WORKDIR /app
COPY requirements-portal.txt ./
# UID 2000 = Metabase runtime UID: both write -wal/-shm of the shared
# portal-data volume (SQLite WAL). Different UIDs = readonly crash loop.
RUN pip install --no-cache-dir -r requirements-portal.txt \
    && groupadd --gid 2000 portal \
    && useradd --uid 2000 --gid portal --no-create-home portal \
    && install -d -o 2000 -g 2000 /data
COPY serve-portal.py ./
COPY api/app.py ./api/
COPY dist/ ./dist/
USER 2000:2000
EXPOSE 8080
CMD ["python", "serve-portal.py"]
