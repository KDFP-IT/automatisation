# Copy to `.env` on the VPS; never commit real values.
LITELLM_BIND=127.0.0.1
LITELLM_PORT=4000

# openssl rand -hex 32; keep LITELLM_SALT_KEY with database backups.
LITELLM_MASTER_KEY=sk-replace-with-64-hex-chars
LITELLM_SALT_KEY=sk-replace-with-different-64-hex-chars
POSTGRES_PASSWORD=replace-with-64-hex-chars

ROUTERAI_API_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_API_KEY=replace-with-routerai-key

LITELLM_OTEL_V2=true
PHOENIX_COLLECTOR_HTTP_ENDPOINT=http://192.168.30.183:6006/v1/traces
PHOENIX_PROJECT_NAME=kdfp-openwebui
NO_PROXY=localhost,127.0.0.1,192.168.30.183
