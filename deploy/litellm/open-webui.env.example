# Installed as ~/.config/systemd/user/open-webui-litellm.env.
# Replace the example key with the LiteLLM virtual key; never commit it.
OPENAI_API_BASE_URL=http://127.0.0.1:4000/v1
OPENAI_API_BASE_URLS=["http://127.0.0.1:4000/v1"]
OPENAI_API_KEYS=["sk-replace-with-litellm-virtual-key"]
OPENAI_API_KEY=sk-replace-with-litellm-virtual-key
ENABLE_OPENAI_API=true
ENABLE_OLLAMA_API=false
ENABLE_FORWARD_USER_INFO_HEADERS=true
DEFAULT_MODELS=tencent/hy4-flash
NO_PROXY=localhost,127.0.0.1
