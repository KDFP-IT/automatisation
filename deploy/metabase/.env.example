# Copy to `.env` (never commit it) and fill in real values.
# `.env` is already covered by the root `.gitignore`.

# Localhost bind: Metabase is published through the reverse proxy over HTTPS,
# never directly. Keep 127.0.0.1 unless the proxy runs on another host.
METABASE_BIND=127.0.0.1
METABASE_PORT=3000

# --- Metabase application database (separate `metabase` DB, see init/01-appdb.sql) ---
MB_DB_TYPE=postgres
# Address of the VPS PostgreSQL as reachable FROM the container
# (not 127.0.0.1 — that would be the container itself).
MB_DB_HOST=192.0.2.10
MB_DB_PORT=5432
MB_DB_DBNAME=metabase
MB_DB_USER=metabase
MB_DB_PASS=change-me

# 32+ random chars; generate with: openssl rand -base64 32
# Losing this key orphans saved DB credentials — back it up with the dump.
MB_ENCRYPTION_SECRET_KEY=change-me-to-32-plus-random-chars

# Internal box: no telemetry.
MB_ANON_TRACKING_ENABLED=false

# Heap for the JVM; needs matching free RAM (2g needs ~3 GB on the box).
# JAVA_OPTS=-Xmx2g
