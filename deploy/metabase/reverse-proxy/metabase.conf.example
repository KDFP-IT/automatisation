# Reverse-proxy snippet for the Metabase subdomain.
# Drop-in for an nginx host that already terminates TLS; replace
# `bi.example.com` with the real hostname from the preflight decision.
# Metabase itself stays bound to 127.0.0.1:3000 (see ../compose.yaml).

server {
    listen 443 ssl;
    server_name bi.example.com;

    # Existing certificate include used by the other hosts on this proxy:
    # include /etc/nginx/tls/bi.example.com.conf;

    client_max_body_size 50m;
    proxy_read_timeout 300s;  # long-running questions

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
